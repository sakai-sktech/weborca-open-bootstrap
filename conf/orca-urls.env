#!/usr/bin/env bash
# ORCA サーバーの URL 単一ソース。
# preflight (Phase 00) と repo 追加 (Phase 20) の両方からこの 1 ファイルを source する。
# 新たに別の URL 文字列をスクリプト内に書き起こさないこと
# (preflight 用と本番用が乖離してハマったため。詳細はプロジェクト規範を参照)。

# Phase 20 が apt-line と keyring の取得に使う実 URL
KEYRING_URL="https://ftp.orca.med.or.jp/pub/ubuntu/archive.key"
LIST_URL="https://ftp.orca.med.or.jp/pub/ubuntu/jma-receipt-weborca-jammy10.list"

# Phase 00 の疎通確認は「Phase 20 が実際に取得するファイル」を叩く。
# 別 URL を立てるとそこだけ通って本番が落ちる事故が起きるので、変数で固定する。
PROBE_URL="${KEYRING_URL}"

# import-dump.sh が使う、スキーマ整合性チェックスクリプト。
# 公式手引き (日レセ運用環境移行) の "スキーマチェック" 節と同じ tgz。
DBSCMCHK_URL="https://ftp.orca.med.or.jp/pub/etc/jma-receipt-dbscmchk.tgz"
