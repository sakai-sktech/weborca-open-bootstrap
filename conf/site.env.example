#!/usr/bin/env bash
# weborca-bootstrap site config
# このファイルを `site.env` にコピーして、案件ごとに編集してください。
#
#   cp conf/site.env.example conf/site.env
#   editor conf/site.env   # Ubuntu default = nano
#
# 想定環境: Ubuntu 22.04 LTS (jammy) Desktop。
# 公式の Ubuntu Japanese Team ISO 直後 (NetworkManager 標準) を想定。

# =====================================================================
# 必須項目 (デフォルト値あり)
# =====================================================================

# OSの管理者ユーザー名 (sudoer)。bootstrap時には既にOS上に存在している前提。
WEBORCA_ADMIN_USER="ormaster"

# ホスト名 (確認・記録用。bootstrapはホスト名を変更しません)
WEBORCA_HOSTNAME="weborca-server"

# =====================================================================
# モード切替
# =====================================================================

# true  : 公式マニュアル準拠 (apt dist-upgrade のみ。git/ssh は導入しない)
# false : 実機ログ準拠 (apt upgrade + autoremove + git + openssh-server)
STRICT_MANUAL="false"

# 追加で入れたいパッケージ (空白区切り)。STRICT_MANUAL=true でも install されます。
# 例: EXTRA_PACKAGES="byobu vim-nox curl"
EXTRA_PACKAGES=""

# =====================================================================
# IPアドレス固定 (Phase 80)
# =====================================================================
# STATIC_IP が空のとき: フェーズはスキップし、IP固定はGUIに任せる。
# 値を入れたとき: nmcli でNetworkManager管理下の接続を永続的に書き換える。

NET_IFACE=""              # 空ならデフォルトルートのインターフェースを自動検出
STATIC_IP=""              # 例: "192.168.0.72"
NETMASK_PREFIX=""         # 例: "24"  (=255.255.255.0)
GATEWAY=""                # 例: "192.168.0.1"
DNS_SERVERS=""            # 空白区切り。例: "192.168.0.1 8.8.8.8"

# systemd-networkd が active だった場合の自動 disable 許可。
# Ubuntu日本語チーム ISO 標準では systemd-networkd は無効なので、
# false のまま。もし active だったら確認プロンプトが出ます。
NETWORKD_DISABLE_OK="false"

# =====================================================================
# IPv6 無効化 (Phase 90)
# =====================================================================
# true にすると /etc/default/grub の GRUB_CMDLINE_LINUX に
# ipv6.disable=1 を追記し、update-grub します。要 reboot。
# WebORCA 公式マニュアル準拠でデフォルト true。
# IPv6 を残したい場合のみ false に変更してください。
ENABLE_IPV6_DISABLE="true"

# =====================================================================
# パスワード自動投入 (Phase 60) -- 本番非推奨
# =====================================================================
# 通常は対話TTYで passwd_store.sh を実行します。
# どうしても無人化したいテスト時のみ、ここに 8〜16文字のパスワードを書きます。
# 本番運用では空 (=対話) のままにしてください。
WEBORCA_ORMASTER_PASSWORD=""

# =====================================================================
# VMで動作確認するときのヒント (参考)
# =====================================================================
# - VMware Workstation / Fusion で 4GB RAM, 40GB Disk, ブリッジNW を推奨
# - Ubuntu 22.04 LTS Desktop (Japanese Remix) で「最小インストール」
# - 1人目の管理者ユーザー名は WEBORCA_ADMIN_USER と一致させる (例: ormaster)
# - インストール直後にスナップショットを取っておくと再試行が速い
